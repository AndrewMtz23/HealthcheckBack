# Export variables before launching the binary; it does not read .env automatically.
PORT=3005
LINK_MONITOR_HOST=127.0.0.1
DB_HOST=localhost
DB_PORT=5432
DB_NAME=healthcheck
DB_USER=postgres
DB_PASSWORD=
# Must match news-service. Never expose this token to the frontend.
LINK_MONITOR_INTERNAL_TOKEN=
LINK_MONITOR_CONCURRENCY=5
LINK_MONITOR_TIMEOUT_SECONDS=15
HEALTHCHECK_DIAGNOSTIC=1
