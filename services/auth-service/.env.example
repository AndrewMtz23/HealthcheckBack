# No real integrations during phase 00. Use scripts/diagnostic-run.cjs.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=healtcheckbd
DB_USER=postgres
DB_PASSWORD=replace-locally
PORT=3001
NODE_ENV=development
JWT_SECRET=replace-with-same-local-secret
JWT_EXPIRATION=86400
FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=disabled-local
GOOGLE_CLIENT_SECRET=disabled-local
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Password recovery only; does not enable notification-service delivery.
# Keep disabled until configured locally. Never commit real values.
RECOVERY_MAIL_ENABLED=false
RECOVERY_SMTP_HOST=
RECOVERY_SMTP_PORT=587
RECOVERY_SMTP_USER=
RECOVERY_SMTP_PASSWORD=
RECOVERY_SMTP_FROM=

# Independent from recovery email; Auth reports worker readiness via health.
NOTIFICATION_DELIVERY_ENABLED=false
NOTIFICATIONS_SERVICE_URL=http://127.0.0.1:3004
